index 9b16d90df..f79317c83 100644
--- a/src/hci.c
+++ b/src/hci.c
@@ -432,6 +432,44 @@ hci_connection_t * hci_connection_for_bd_addr_and_type(const bd_addr_t  addr, bd
     return NULL;
 }
 
+uint8_t hci_adopt_classic_connection(const bd_addr_t addr,
+                                     hci_con_handle_t con_handle,
+                                     hci_role_t role,
+                                     bool authenticated,
+                                     bool encrypted){
+#ifdef ENABLE_CLASSIC
+    if (hci_stack == NULL || hci_stack->state != HCI_STATE_OFF ||
+        con_handle > 0x0effu || !authenticated || !encrypted) {
+        return ERROR_CODE_COMMAND_DISALLOWED;
+    }
+    if (hci_connection_for_handle(con_handle) != NULL ||
+        hci_connection_for_bd_addr_and_type(addr, BD_ADDR_TYPE_ACL) != NULL) {
+        return ERROR_CODE_ACL_CONNECTION_ALREADY_EXISTS;
+    }
+
+    hci_connection_t * connection =
+        create_connection_for_bd_addr_and_type(addr, BD_ADDR_TYPE_ACL, role);
+    if (connection == NULL) return BTSTACK_MEMORY_ALLOC_FAILED;
+
+    connection->con_handle = con_handle;
+    connection->state = OPEN;
+    connection->encryption_key_size = 0;
+    connection->encryption_key_type =
+        UNAUTHENTICATED_COMBINATION_KEY_GENERATED_FROM_P192;
+    connection->authentication_flags |= AUTH_FLAG_CONNECTION_AUTHENTICATED;
+    connection->bonding_flags |= BONDING_SEND_READ_ENCRYPTION_KEY_SIZE;
+    hci_remote_features_query(con_handle);
+    return ERROR_CODE_SUCCESS;
+#else
+    UNUSED(addr);
+    UNUSED(con_handle);
+    UNUSED(role);
+    UNUSED(authenticated);
+    UNUSED(encrypted);
+    return ERROR_CODE_UNSUPPORTED_FEATURE_OR_PARAMETER_VALUE;
+#endif
+}
