+int hci_power_control_on_without_reset(void){
+    if (hci_stack == NULL || hci_stack->state != HCI_STATE_OFF) {
+        return ERROR_CODE_COMMAND_DISALLOWED;
+    }
+
+    btstack_run_loop_remove_timer(&hci_stack->timeout);
+    int err = hci_power_control_on();
+    if (err != 0) return err;
+
+    hci_stack->num_cmd_packets = 1;
+    hci_stack->hci_packet_buffer_reserved = false;
+    hci_stack->state = HCI_STATE_INITIALIZING;
+    hci_stack->substate = HCI_INIT_SEND_READ_LOCAL_VERSION_INFORMATION;
+    hci_emit_state();
+    hci_run();
+    return ERROR_CODE_SUCCESS;
+}
